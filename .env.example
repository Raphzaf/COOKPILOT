# ─────────────────────────────────────────────────────────────
# CookPilot environment variables — copy to .env.local
# Never commit real values. See docs/ENVIRONMENT_VARIABLES.md
# With everything empty the app runs in clearly-labelled DEMO MODE.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (project created with your separate Google account — see SUPABASE_SETUP.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (Gemini) — server only
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
AI_INPUT_COST_PER_MTOK_USD=
AI_OUTPUT_COST_PER_MTOK_USD=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Analytics (PostHog). POSTHOG_KEY is used server-side; the NEXT_PUBLIC_ variant enables browser analytics.
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Error monitoring (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
